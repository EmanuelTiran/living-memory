{
  "name": "living-memory",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "test:e2e": "playwright test --config server/playwright.config.js",
    "test:e2e:pilot": "playwright test memoryPilot.e2e.js --config server/playwright.config.js",
    "test:e2e:pricing": "playwright test pricingPilot.e2e.js --config server/playwright.config.js",
    "check": "npm run lint && npm test && npm run build",
    "dev": "concurrently -n server,client -c blue,green npm:dev:server npm:dev:client"
  }
}
