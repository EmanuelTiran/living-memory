NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/living_memory?appName=LivingMemory
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_43_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Private pilot defaults
PILOT_INVITE_ONLY=true
PILOT_AVATAR_ENABLED=false
SERVE_CLIENT_BUILD=true
PERSISTENT_STORAGE_REQUIRED=true
TRUST_PROXY_HOPS=1

# Core AI and transcription
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_TIMEOUT_MS=120000
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=marin
OPENAI_SPEECH_TIMEOUT_MS=60000

# Optional synthetic voice; leave blank until separately approved
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_TIMEOUT_MS=120000

# Avatar is disabled for the private pilot
DID_API_KEY=
DID_API_KEY_MODE=ENCODE_UTF8
DID_AGENT_ID=
DID_CLIENT_KEY=
DID_AVATAR_IMAGE_PATH=/var/lib/living-memory/assets/avatar.png
DID_TIMEOUT_MS=120000
DID_POLL_INTERVAL_MS=2000
DID_POLL_TIMEOUT_MS=240000

# Mount one persistent disk at /var/lib/living-memory
RECORDING_STORAGE_ROOT=/var/lib/living-memory/recordings
MEMORY_ASSET_STORAGE_ROOT=/var/lib/living-memory/memory-assets
